# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# netlify (local CLI state, not source)
/.netlify

# generated standalone server bundle for the Netlify Function (built by
# scripts/prepare-netlify-function.mjs, not source)
/netlify/functions/next-server/standalone

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database
/prisma/dev.db
/prisma/dev.db-journal

# user-uploaded files (runtime artifacts, not source)
/public/uploads/*
!/public/uploads/.gitkeep
